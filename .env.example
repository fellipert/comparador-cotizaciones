PORT=3000
DATA_DIR=./data

# Dirección pública del comparador. Con ella se arman los enlaces de los correos
# (recuperar contraseña, invitaciones, avisos de subasta). Sin APP_URL los enlaces salen incompletos.
APP_URL=https://tu-dominio.com

# Correo saliente. Si SMTP_HOST o SMTP_FROM están vacíos, los correos NO se envían:
# se escriben en el registro del servidor (journalctl) para no bloquear nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mercaldas Compras <compras@tu-dominio.com>

# Opcional: 1 obliga a que la cookie de sesión solo viaje por https.
# Detrás de nginx con https no hace falta (se detecta con X-Forwarded-Proto).
# COOKIE_SECURE=1

# Tareas automáticas (hora de Colombia): el viernes a las 6:00 a.m. se abre la semana y sale la solicitud de cotización;
# de viernes a lunes a las 7:00 p.m. salen solas las contrapropuestas al portal de los proveedores.
# Por defecto corren en producción y quedan apagadas con APP_ENV=dev (DEV suele tener copia de la base real).
# 1 las enciende y 0 las apaga en cualquier entorno.
# TAREAS_AUTOMATICAS=1
