# Copia este bloque a /etc/nginx/sites-available/comparador-cotizaciones
# y crea el enlace simbólico en sites-enabled. Reemplaza tu-dominio.com.

server {
    listen 80;
    server_name tu-dominio.com www.tu-dominio.com;

    client_max_body_size 20M;  # permite subir varios .xlsx a la vez

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# Después de activar este bloque, corre:
#   sudo certbot --nginx -d tu-dominio.com -d www.tu-dominio.com
# para emitir el certificado SSL gratis y servir la app por https.

